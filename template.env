# status.versatiles.org configuration
# Copy this file to .env and fill in the values. .env is not committed: keep a
# copy of it in the password manager, so a rebuilt server can be set up again.

# Domain name
DOMAIN_NAME=status.versatiles.org

# E-mail address for the Let's Encrypt account. Must be a real address: setup
# refuses the placeholder.
EMAIL=name@example.org

# Pushover keys for alerts (https://pushover.net). The application token comes
# from an application created for Gatus, the user key from the account page.
# Without them Gatus shows the page but sends no alerts.
PUSHOVER_APPLICATION_TOKEN=
PUSHOVER_USER_KEY=
