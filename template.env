# status.versatiles.org configuration
# Copy this file to .env and fill in the values. .env is not committed: keep a
# copy of it in the password manager, so a rebuilt server can be set up again.

# Domain name
DOMAIN_NAME=status.versatiles.org

# E-mail address for the Let's Encrypt account. Must be a real address: setup
# refuses the placeholder.
EMAIL=name@example.org

# Pushover keys for alerts (https://pushover.net). The application token comes
# from an application created for Gatus, the user key from the account page.
# Without them Gatus shows the page but sends no alerts.
PUSHOVER_APPLICATION_TOKEN=
PUSHOVER_USER_KEY=

# Token bin/push/checks.sh uses to report its results to Gatus. Leave empty:
# bin/setup.sh and bin/update.sh generate one.
GATUS_PUSH_TOKEN=

# Signs the sessions of the private area. Leave empty: bin/setup.sh and
# bin/update.sh generate one. Changing it logs everyone out.
LOGIN_SECRET=

# GitHub signs its webhook deliveries with this, see bin/webhook/setup.sh.
# Leave empty: bin/setup.sh and bin/update.sh generate one. Copy it into the
# webhook's settings on GitHub.
WEBHOOK_SECRET=

# One token per server that reports its cron jobs to POST /report, for the
# private dashboard (login/report.js). Leave empty: bin/setup.sh and
# bin/update.sh generate them. Copy each into that server's .env. To replace
# a token, empty it here and run bin/update.sh.
REPORT_TOKEN_TILES=
REPORT_TOKEN_GEOCODE=
REPORT_TOKEN_STATUS=

# Optional: the repo of this server's code, as owner/name. When its CI passes
# on the default branch, the webhook runs bin/update.sh. Needs a webhook in
# that repo's settings for "Workflow runs", see bin/webhook/setup.sh. Empty:
# update by hand.
UPDATE_REPO=versatiles-org/status.versatiles.org

# Optional: the Client ID of the read-only GitHub App that the dependency
# status at /private/dependency-status/ reads the organisation's repos with.
# Its private key goes to volumes/github-app/private-key.pem, see README.md.
# Empty: no dependency status.
GITHUB_APP_CLIENT_ID=

# Optional: a private git repo (SSH URL) whose `npm run dashboard -- --out <dir>`
# generates the dashboard at /private/dashboard/. bin/dashboard/setup.sh creates
# the read-only deploy key for it. Empty: no dashboard.
DASHBOARD_REPO=
